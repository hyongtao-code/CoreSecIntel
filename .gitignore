# ============================================================================
# 密钥与本地数据 —— 绝不提交
# ============================================================================

# 环境变量文件（含 LLM 密钥、SMTP 密码）
.env
.env.*
!.env.example

# 数据库
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 运行时产物（只忽略项目根下的输出目录，避免误伤 signalintel/reports/ 包）
/logs/
*.log
/reports/

# 生成的 HTML 报告（不含源码目录下的模板）
/data/**/*.html
*.html
!signalintel/reports/templates/*.html

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store

# 临时脚本
/tmp/
