# ============================================================================
# 环境变量模板 —— 复制为 .env 并填入真实值
#
#   cp .env.example .env
#
# 注意：.env 包含密钥，不要提交到版本库（.gitignore 已包含）。
# 真实环境变量优先于 .env 文件中的值。
# ============================================================================

# ----------------------------------------------------------------------------
# 大模型 API（OpenAI 兼容 Chat Completions）
# ----------------------------------------------------------------------------
# 生成本文件时，LLM 密钥可从环境变量 MINIMAX_CN_API_KEY 读取，
# 或用 setup_env.py --llm-key 显式传入：
#   export MINIMAX_CN_API_KEY=*** python3 scripts/setup_env.py --email <邮箱> --to <收件人>
# API Base 地址，例如：
#   OpenAI 官方：      https://api.openai.com/v1
#   Azure OpenAI：     https://<资源名>.openai.azure.com/openai/deployments/<部署名>
#   本地 Ollama：      http://127.0.0.1:11434/v1
#   其它兼容服务：     https://<服务地址>/v1
LLM_API_BASE=https://api.openai.com/v1

# API 密钥（必填）。留空则跳过分类与摘要阶段，仅做关键词召回与评分。
LLM_API_KEY=

# 模型名称
LLM_MODEL=gpt-4o-mini

# 单次请求超时（秒）
LLM_TIMEOUT=60

# 单次请求最大重试次数
LLM_MAX_RETRIES=3

# 采样温度（摘要任务建议较低值）
LLM_TEMPERATURE=0.2

# 批量摘要时每批条目数
LLM_MAX_BATCH_SIZE=5

# 单次运行最多调用大模型处理的条目数（控制成本）
LLM_MAX_ITEMS=60

# ----------------------------------------------------------------------------
# SMTP 邮件发送
# ----------------------------------------------------------------------------
SMTP_HOST=

# 465 = 隐式 SSL；587 = STARTTLS
SMTP_PORT=465

# SMTP 认证账号与密码（部分企业邮箱需要）
SMTP_USER=
SMTP_PASSWORD=

# 是否启用 TLS。
#   端口 465 时使用隐式 SSL（可用 SMTP_USE_SSL=false 关闭）
#   端口 587 时使用 STARTTLS
SMTP_USE_TLS=true

# 是否使用隐式 SSL（端口 465 通常为 true）
SMTP_USE_SSL=true

# 发件人地址（建议与 SMTP_USER 一致，否则可能被拒收）
EMAIL_FROM=

# 收件人，多个用逗号分隔
EMAIL_TO=

# ----------------------------------------------------------------------------
# 采集与调度
# ----------------------------------------------------------------------------
# 时区
TIMEZONE=Asia/Shanghai

# 时间窗口天数（默认最近 7 天）
WINDOW_DAYS=7

# 数据目录（SQLite 数据库与报告输出位置）
DATA_DIR=./data

# 日志目录
LOG_DIR=./logs

# 数据库文件路径
DB_PATH=./data/signalintel.db

# ----------------------------------------------------------------------------
# 需要 API Key 的数据源（在 config/sources.yaml 中启用对应来源时生效）
# ----------------------------------------------------------------------------
# IEEE Xplore API Key，免费注册：https://ieeexploreapi.ieee.org/
IEEE_API_KEY=

# ----------------------------------------------------------------------------
# HTTP 采集行为
# ----------------------------------------------------------------------------
# 同一数据源两次请求之间的最小间隔（秒），用于遵守访问频率限制
HTTP_MIN_INTERVAL=1.0

# 采集请求超时（秒）
HTTP_TIMEOUT=30

# 采集请求重试次数
HTTP_MAX_RETRIES=3
